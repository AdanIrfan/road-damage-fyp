# Base URL of the main backend API, WITHOUT a trailing slash.
# Leave empty in development: the Vite dev server proxies /api to http://localhost:3000.
# In production, set it only if the API is served from a different origin than the frontend
# (that origin must then also be listed in the backend's CORS_ORIGIN).
VITE_API_BASE_URL=

# Development only (not sent to the browser): where the Vite dev server proxies /api.
# Defaults to http://localhost:3000.
# API_PROXY_TARGET=http://localhost:3000
