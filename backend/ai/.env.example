# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by Git. NEVER commit real secrets.

# Shared secret the main backend sends in the X-AI-Service-Key header.
# Must be the SAME value as AI_SERVICE_SECRET in backend/api/.env. At least 32 characters.
# Generate one with:  openssl rand -base64 48
AI_SHARED_SECRET=CHANGE_ME_generate_a_long_random_secret

# Trained YOLOv8 weights (not in Git). Relative paths are resolved from backend/ai/.
AI_MODEL_PATH=weights/best.pt

# Detection thresholds (Ultralytics defaults). Detections below the confidence are discarded.
AI_CONFIDENCE_THRESHOLD=0.25
AI_IOU_THRESHOLD=0.7

# Inference image size (the model was trained at 640) and device (cpu agreed for now).
AI_IMAGE_SIZE=640
AI_DEVICE=cpu

# Largest accepted upload in bytes (10 MB) and largest image in pixels (8000 x 8000).
AI_MAX_IMAGE_BYTES=10485760
AI_MAX_IMAGE_PIXELS=64000000
