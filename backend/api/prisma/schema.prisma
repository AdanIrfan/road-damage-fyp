// Prisma schema for the main backend.
// Prisma 7: the database URL is NOT set here. The CLI reads it from
// prisma.config.ts, and the app connects through the PrismaPg driver adapter
// (see src/db/prisma.ts).
//
// Phase 2 (authentication and user management): users, OTP codes, refresh tokens.
// Phase 3 (citizen reporting): reports, report images, AI detections, report status history.
// Stage 4 (admin & engineer workflows): assignments, repair attempts, repair updates, repair photos.
// Phase 5 (admin-engineer chat): conversations, chat messages.
// Models for later phases (notifications, ...) are NOT added yet.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  ADMIN
  ENGINEER
}

enum AccountStatus {
  /// Citizen registered but has not verified their mobile number yet. Cannot log in.
  PENDING_VERIFICATION
  ACTIVE
  /// Disabled by an admin (or never activated). Cannot log in; sessions are revoked.
  DEACTIVATED
}

enum OtpPurpose {
  MOBILE_VERIFICATION
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(100)
  /// E.164 format, e.g. +15551234567. Used as the login identifier.
  mobileNumber       String        @unique @map("mobile_number") @db.VarChar(20)
  /// Argon2id hash. Never returned by the API.
  passwordHash       String        @map("password_hash")
  role               UserRole
  status             AccountStatus
  mobileVerifiedAt   DateTime?     @map("mobile_verified_at") @db.Timestamptz(3)
  /// True for accounts with an admin-set temporary password (engineers, bootstrap admins).
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  /// Admin who created this account (engineers). Null for self-registered citizens and the first admin.
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User?                 @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]                @relation("UserCreatedBy")
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  reports       Report[]              @relation("ReportCitizen")
  severityEdits Report[]              @relation("ReportAdminSeverity")
  statusChanges ReportStatusHistory[]

  assignedReports     Report[]           @relation("ReportAssignedEngineer")
  assignmentsReceived ReportAssignment[] @relation("AssignmentEngineer")
  assignmentsReplaced ReportAssignment[] @relation("AssignmentPreviousEngineer")
  assignmentsMade     ReportAssignment[] @relation("AssignmentAssignedBy")
  repairUpdates       RepairUpdate[]
  repairPhotos        RepairPhoto[]

  adminConversations    Conversation[] @relation("ConversationAdmin")
  engineerConversations Conversation[] @relation("ConversationEngineer")
  chatMessagesSent      ChatMessage[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  purpose    OtpPurpose
  /// HMAC-SHA256 of the code (keyed with a server secret). The code itself is never stored.
  codeHash   String     @map("code_hash") @db.VarChar(64)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  /// Number of failed verification attempts for this code.
  attempts   Int        @default(0)
  /// Set when the code is used successfully or superseded; a consumed code can never be used again.
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the random refresh token. The token itself is only ever in the client's cookie.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  /// All tokens created by rotating one login session share a family. Reuse of a rotated
  /// token revokes the whole family.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// The token that replaced this one during rotation.
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 3: citizen reports
// ---------------------------------------------------------------------------

/// Report workflow status (CLAUDE.md §3). Only SUBMITTED is used until the admin review phase.
enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  DELAYED
  COMPLETED
}

enum CaptureMethod {
  LIVE_CAMERA
  GALLERY_UPLOAD
}

/// Gallery uploads: VERIFIED | MISMATCH | NO_METADATA | NOT_CHECKED. Live camera: BROWSER_GPS.
enum LocationVerificationStatus {
  VERIFIED
  MISMATCH
  NO_METADATA
  NOT_CHECKED
  BROWSER_GPS
}

enum AiAnalysisStatus {
  /// The AI service answered with a valid result (which may contain zero detections).
  COMPLETED
  /// The AI service was unavailable, timed out or answered with an invalid response.
  FAILED
}

/// Estimated severity (heuristic, NOT an engineering measurement).
enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

model Report {
  id                    String                     @id @default(uuid()) @db.Uuid
  citizenId             String                     @map("citizen_id") @db.Uuid
  status                ReportStatus               @default(SUBMITTED)
  captureMethod         CaptureMethod              @map("capture_method")
  description           String?                    @db.VarChar(1000)
  /// Location chosen on the map (gallery) or captured by browser GPS (live camera). WGS84 degrees.
  latitude              Float
  longitude             Float
  /// Browser-reported GPS accuracy in metres (live camera only).
  gpsAccuracyM          Float?                     @map("gps_accuracy_m")
  locationStatus        LocationVerificationStatus @map("location_status")
  /// True when an admin should check the location (mismatch, no metadata, poor GPS accuracy).
  locationNeedsReview   Boolean                    @map("location_needs_review")
  /// GPS position read from the original photo's EXIF (gallery uploads). Never sent to citizens.
  exifLatitude          Float?                     @map("exif_latitude")
  exifLongitude         Float?                     @map("exif_longitude")
  /// Haversine distance between the EXIF position and the selected location, in metres.
  exifDistanceM         Float?                     @map("exif_distance_m")
  aiStatus              AiAnalysisStatus           @map("ai_status")
  /// Why the analysis failed (unavailable | timeout | rejected | invalid_response).
  aiErrorCode           String?                    @map("ai_error_code") @db.VarChar(40)
  /// Model name reported by the AI service.
  aiModel               String?                    @map("ai_model") @db.VarChar(100)
  aiAnalyzedAt          DateTime?                  @map("ai_analyzed_at") @db.Timestamptz(3)
  /// Estimated severity computed by the main backend from the AI detections. Null if no damage was detected or the analysis failed.
  aiSeverity            SeverityLevel?             @map("ai_severity")
  aiSeverityScore       Float?                     @map("ai_severity_score")
  /// Severity set by an admin (admin review phase). The AI value is always kept as well.
  adminSeverity         SeverityLevel?             @map("admin_severity")
  adminSeverityById     String?                    @map("admin_severity_by_id") @db.Uuid
  adminSeverityAt       DateTime?                  @map("admin_severity_at") @db.Timestamptz(3)
  /// Engineer currently responsible for the repair (Stage 4). NULL = unassigned.
  assignedEngineerId    String?                    @map("assigned_engineer_id") @db.Uuid
  assignedAt            DateTime?                  @map("assigned_at") @db.Timestamptz(3)
  /// Repair status of the CURRENT attempt. Changed only by the assigned engineer (PENDING is the initial state of an attempt). NULL until assigned.
  repairStatus          RepairStatus?              @map("repair_status")
  repairStatusUpdatedAt DateTime?                  @map("repair_status_updated_at") @db.Timestamptz(3)
  /// Current repair attempt (1, 2, ...). 1 on first assignment; +1 on reassignment and on reopen. Never decreases. NULL until assigned.
  repairAttempt         Int?                       @map("repair_attempt")
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  citizen          User                  @relation("ReportCitizen", fields: [citizenId], references: [id], onDelete: Restrict)
  adminSeverityBy  User?                 @relation("ReportAdminSeverity", fields: [adminSeverityById], references: [id], onDelete: SetNull)
  assignedEngineer User?                 @relation("ReportAssignedEngineer", fields: [assignedEngineerId], references: [id], onDelete: SetNull)
  images           ReportImage[]
  detections       AiDetection[]
  statusHistory    ReportStatusHistory[]
  assignments      ReportAssignment[]
  repairUpdates    RepairUpdate[]
  repairPhotos     RepairPhoto[]

  @@index([citizenId, createdAt])
  @@index([status, createdAt])
  @@index([aiSeverity])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([assignedEngineerId, repairStatus])
  @@index([status, repairStatus])
  @@map("reports")
}

/// One uploaded photo. Files live in UPLOAD_DIR; only their random keys are stored here.
model ReportImage {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  /// The upload exactly as received (keeps EXIF). Private: never served.
  originalKey String   @unique @map("original_key") @db.VarChar(200)
  /// Re-encoded JPEG without metadata, orientation applied. The only copy that is served.
  displayKey  String   @unique @map("display_key") @db.VarChar(200)
  /// MIME type of the original upload (detected from its content).
  mimeType    String   @map("mime_type") @db.VarChar(50)
  sizeBytes   Int      @map("size_bytes")
  /// Dimensions of the display copy (the coordinate space of the AI boxes).
  width       Int
  height      Int
  /// SHA-256 of the original upload.
  sha256      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report     Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  detections AiDetection[]

  @@index([reportId])
  @@map("report_images")
}

/// One raw detection returned by the AI service. Box coordinates are pixels of the display image.
model AiDetection {
  id           String @id @default(uuid()) @db.Uuid
  reportId     String @map("report_id") @db.Uuid
  imageId      String @map("image_id") @db.Uuid
  classId      Int    @map("class_id")
  className    String @map("class_name") @db.VarChar(100)
  confidence   Float
  x1           Float
  y1           Float
  x2           Float
  y2           Float
  /// Box area divided by image area (0..1).
  areaFraction Float  @map("area_fraction")

  report Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  image  ReportImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([imageId])
  @@index([className])
  @@map("ai_detections")
}

/// Audit trail of report status changes (who, what, when).
model ReportStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  reportId    String        @map("report_id") @db.Uuid
  fromStatus  ReportStatus? @map("from_status")
  toStatus    ReportStatus  @map("to_status")
  changedById String?       @map("changed_by_id") @db.Uuid
  note        String?       @db.VarChar(1000)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@map("report_status_history")
}

// ---------------------------------------------------------------------------
// Stage 4: assignments and repair work (organised in numbered repair attempts)
// ---------------------------------------------------------------------------

/// Repair status of one attempt. Exactly these three values (CLAUDE.md §3).
enum RepairStatus {
  PENDING
  WORKING
  COMPLETED
}

enum RepairUpdateKind {
  /// The engineer changed the repair status (from/to are set).
  STATUS_CHANGE
  /// A progress note by the engineer.
  NOTE
  /// "Needs more work" note by an admin on a Completed attempt.
  ADMIN_FEEDBACK
}

/// Audit trail of (re)assignments. Each one starts a new repair attempt.
model ReportAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  reportId           String   @map("report_id") @db.Uuid
  engineerId         String   @map("engineer_id") @db.Uuid
  previousEngineerId String?  @map("previous_engineer_id") @db.Uuid
  assignedById       String   @map("assigned_by_id") @db.Uuid
  reason             String?  @db.VarChar(500)
  /// The repair attempt this assignment started.
  attempt            Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report           Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  engineer         User   @relation("AssignmentEngineer", fields: [engineerId], references: [id], onDelete: Restrict)
  previousEngineer User?  @relation("AssignmentPreviousEngineer", fields: [previousEngineerId], references: [id], onDelete: SetNull)
  assignedBy       User   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([engineerId])
  @@map("report_assignments")
}

/// Engineer progress (status changes, notes) and admin feedback, per attempt. Never deleted.
model RepairUpdate {
  id         String           @id @default(uuid()) @db.Uuid
  reportId   String           @map("report_id") @db.Uuid
  authorId   String           @map("author_id") @db.Uuid
  kind       RepairUpdateKind
  attempt    Int
  fromStatus RepairStatus?    @map("from_status")
  toStatus   RepairStatus?    @map("to_status")
  note       String?          @db.VarChar(1000)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("repair_updates")
}

/// Repair evidence photo, tagged with the attempt it belongs to. Never deleted or re-tagged.
model RepairPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  attempt      Int
  /// The upload exactly as received (keeps EXIF). Private: never served.
  originalKey  String   @unique @map("original_key") @db.VarChar(200)
  /// Re-encoded JPEG without metadata. The only copy that is served.
  displayKey   String   @unique @map("display_key") @db.VarChar(200)
  mimeType     String   @map("mime_type") @db.VarChar(50)
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  sha256       String   @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([reportId, attempt])
  @@map("repair_photos")
}

// ---------------------------------------------------------------------------
// Phase 5: admin-engineer chat
// ---------------------------------------------------------------------------

/// One private conversation per (admin, engineer) pair. Roles are enforced in the service.
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  adminId       String    @map("admin_id") @db.Uuid
  engineerId    String    @map("engineer_id") @db.Uuid
  /// Time of the newest message (for ordering the conversation list).
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin    User          @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  engineer User          @relation("ConversationEngineer", fields: [engineerId], references: [id], onDelete: Restrict)
  messages ChatMessage[]

  @@unique([adminId, engineerId])
  @@index([engineerId])
  @@map("conversations")
}

/// A chat message. Plain text only; never edited or deleted.
model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  /// Random id chosen by the sending client. A retried send with the same id returns the stored
  /// message instead of saving a duplicate (the acknowledgement may have been lost).
  clientId       String   @map("client_id") @db.Uuid
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@map("chat_messages")
}
