# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by Git. NEVER commit real passwords or secrets.

# development | production | test
NODE_ENV=development

# Port the API listens on
PORT=3000

# Browser origins allowed to call the API (CORS), comma-separated, no paths.
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Optional in development/test (defaults to the Vite dev server, http://localhost:5173).
# REQUIRED in production. "*" is not allowed.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by Prisma.
# Replace YOUR_PASSWORD with the real password of road_damage_user.
# If the password contains special characters (@ : / ? # & %), URL-encode them.
DATABASE_URL="postgresql://road_damage_user:YOUR_PASSWORD@localhost:5432/road_damage_db?schema=public"

# Master secret for authentication: JWT signing, OTP hashing and CSRF tokens use keys
# derived from it. At least 32 characters. Generate one with:  openssl rand -base64 48
# Changing it logs everyone out and invalidates pending OTP codes.
AUTH_SECRET=CHANGE_ME_generate_a_long_random_secret

# How OTP SMS messages are delivered.
#   mock = DEVELOPMENT ONLY: nothing is sent; codes are printed to the server console.
# No real SMS provider is implemented yet, so the server refuses to start in production.
SMS_PROVIDER=mock

# Optional: two-letter country code (e.g. GB, US) used when a mobile number is entered
# without its +country code. If empty, users must type the +country code.
PHONE_DEFAULT_COUNTRY=

# Optional: SameSite attribute of the auth cookies: lax (default) | strict | none.
# "none" is only needed if the frontend and API are on different sites, and requires
# NODE_ENV=production (secure cookies, HTTPS).
COOKIE_SAMESITE=lax

# ---------- AI inference service (backend/ai) ----------
# Internal address of the FastAPI service. Never exposed to the frontend.
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent in the X-AI-Service-Key header. Must equal AI_SHARED_SECRET in backend/ai/.env.
# At least 32 characters. Generate one with:  openssl rand -base64 48
AI_SERVICE_SECRET=CHANGE_ME_generate_a_long_random_secret
# Optional: how long to wait for an analysis before giving up (milliseconds). Default 30000.
AI_REQUEST_TIMEOUT_MS=30000

# ---------- Report uploads and location checks ----------
# Optional: where uploaded photos are stored (relative to backend/api/). Never served directly; not in Git.
UPLOAD_DIR=storage/uploads
# Optional: gallery uploads whose EXIF GPS is within this distance of the selected location are "verified".
EXIF_LOCATION_TOLERANCE_KM=2
# Optional: live-camera reports with browser GPS accuracy worse than this are flagged for admin review.
GPS_ACCURACY_THRESHOLD_METERS=100

# Optional, tests only: schema used by the database tests (must end with _test).
# TEST_DATABASE_SCHEMA=app_test
